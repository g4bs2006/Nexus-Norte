# Supabase — copie este arquivo para .env.local e preencha.
# .env.local é ignorado pelo git (padrão *.local no .gitignore).
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Chave pública VAPID (notificações push) — é pública por natureza, não é
# segredo. A privada mora só nos secrets da Edge Function `notificar`.
VITE_VAPID_PUBLIC_KEY=
