{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path alias — sem baseUrl (deprecado no TS 6); paths resolve
       relativo à localização deste tsconfig. */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* TypeScript estrito — exigido pelo plano (seção 9): volume de cálculos
       numéricos sensíveis (médias, projeções financeiras, 1RM).
       `exactOptionalPropertyTypes` foi deliberadamente omitido: conflita com
       os componentes vendored do shadcn/ui, que são regerados a cada
       `shadcn add` e não estão sob nosso controle. */
    "strict": true,
    "noUncheckedIndexedAccess": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
