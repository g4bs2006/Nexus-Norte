# Dependências e builds (o app/ tem seu próprio .gitignore mais específico)
node_modules/
dist/

# Variáveis de ambiente — nunca comitar credenciais
.env
.env.*
!.env.example
*.local

# Sistema operacional
.DS_Store
Thumbs.db

# Editores
.vscode/*
!.vscode/extensions.json
.idea/

# Saída do graphify — grafo regenerável, não versionado
graphify-out/

# Previews gerados do design system (rode design-system/gerar.py)
design-system/out/

# Estado local do Claude Code — worktrees e config de sessão
.claude/

# Cache local da CLI do Supabase
app/supabase/.temp/
